# PCB_AI_DESIGNER_V3 — variables d'environnement (exemple)
# Copier vers .env et compléter.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
PYTHONPATH=/app:/app/backend

# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://pcb:pcb@localhost:5432/pcb_ai_v3

# --- Cache / event bus ---
REDIS_URL=redis://localhost:6379/0
EVENT_BUS_BACKEND=inprocess        # inprocess | redis

# --- Stockage objet (datasets, modèles, exports) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=pcb
S3_SECRET_KEY=pcb-secret
S3_BUCKET=pcb-ai-v3

# --- Sécurité / multi-tenant ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM (cerveau symbolique) ---
LLM_PROVIDER=mock                  # mock | openai | zai | azure
LLM_MODEL=gpt-4o
OPENAI_API_KEY=                    # requis si LLM_PROVIDER=openai
LLM_API_KEY=                       # alias générique accepté par le provider
ZAI_API_KEY=
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2

# --- RL / entraînement (cerveau décisionnel) ---
RL_DEVICE=cuda                    # cuda | cpu
RL_CHECKPOINT_DIR=data/trained_models/policies
WORLD_MODEL_DIR=data/trained_models/world_models

# --- Simulateurs (cerveau physique) ---
SIM_MAX_WORKERS=4
SURROGATE_MODELS_DIR=data/trained_models/surrogate_models

# --- EDA / KiCad ---
KICAD_PYTHON_PATH=/usr/lib/kicad/6.0
KICAD_LIVE_WS=ws://localhost:7999

# --- Manufacturing ---
PCBWAY_API_KEY=
JLCPCB_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Facturation ---
CREDITS_FREE_TIER=100
